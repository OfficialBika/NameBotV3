# NameBot V3
BOT_TOKEN=
OWNER_ID=
MONGO_URI=
DB_NAME=waifu_adding_v2

# Canonical Adding-Helperbot unified Mongo schema
UNIFIED_ADDING_DB_ENABLED=true
UNIFIED_ADDING_COLLECTION=characters
# Set this only when the Adding DB is different from DB_NAME.
# ADDING_DB_NAME=...
# UNIFIED_ADDING_DB_NAME=...

# Adding Bot → NameBot V3 data sync
ADDING_DATA_SYNC_POLL_SECONDS=2

# Lookup engine
LOOKUP_ENGINE_MODE=snapshot
SNAPSHOT_STARTUP_LOAD=true
SNAPSHOT_BACKGROUND_REFRESH=true
SNAPSHOT_INCREMENTAL_SYNC_SECONDS=10
SNAPSHOT_FULL_REBUILD_SECONDS=3600

# SQLite hybrid (optional)
SQLITE_INDEX_PATH=data/fingerprint_index.db
SQLITE_SYNC_SECONDS=10
SQLITE_BUILD_ON_START=true
SQLITE_REBUILD_ON_START=false
